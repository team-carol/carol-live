<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

  <SurfaceView
      android:id="@+id/preview"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

  <!-- everything drawn over the preview; padded by system bar / cutout insets in code -->
  <FrameLayout
      android:id="@+id/overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:padding="@dimen/crl_space_4">

    <!-- status panel: crl-card (translucent) with a crl-tag and a crl-stat row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/crl_panel_overlay"
        android:orientation="vertical"
        android:paddingStart="@dimen/crl_space_5"
        android:paddingTop="@dimen/crl_space_4"
        android:paddingEnd="@dimen/crl_space_5"
        android:paddingBottom="@dimen/crl_space_4">

      <TextView
          android:id="@+id/txt_state"
          style="@style/Crl.Tag.Large"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="준비 중" />

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_4"
          android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="76dp"
            android:orientation="vertical">
          <TextView style="@style/Crl.Text.StatLabel" android:layout_width="wrap_content"
              android:layout_height="wrap_content" android:text="송출" />
          <TextView android:id="@+id/stat_bitrate" style="@style/Crl.Text.StatValue"
              android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/crl_space_6"
            android:minWidth="44dp"
            android:orientation="vertical">
          <TextView style="@style/Crl.Text.StatLabel" android:layout_width="wrap_content"
              android:layout_height="wrap_content" android:text="FPS" />
          <TextView android:id="@+id/stat_fps" style="@style/Crl.Text.StatValue"
              android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/crl_space_6"
            android:minWidth="52dp"
            android:orientation="vertical">
          <TextView style="@style/Crl.Text.StatLabel" android:layout_width="wrap_content"
              android:layout_height="wrap_content" android:text="배터리" />
          <TextView android:id="@+id/stat_battery" style="@style/Crl.Text.StatValue"
              android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/crl_space_6"
            android:minWidth="60dp"
            android:orientation="vertical">
          <TextView style="@style/Crl.Text.StatLabel" android:layout_width="wrap_content"
              android:layout_height="wrap_content" android:text="온도" />
          <TextView android:id="@+id/stat_temp" style="@style/Crl.Text.StatValue"
              android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" />
        </LinearLayout>
      </LinearLayout>

      <TextView
          android:id="@+id/txt_video_meta"
          style="@style/Crl.Text.Caption"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3" />

      <TextView
          android:id="@+id/txt_audio_meta"
          style="@style/Crl.Text.Caption"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_1" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_settings"
        style="@style/Crl.Button.Secondary.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:text="설정" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <Button
          android:id="@+id/btn_ev_down"
          style="@style/Crl.Button.Secondary.Small"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="EV −" />

      <TextView
          android:id="@+id/txt_exposure"
          style="@style/Crl.Tag.Large"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/crl_space_3"
          android:layout_marginEnd="@dimen/crl_space_3"
          android:minWidth="72dp"
          android:gravity="center"
          android:textColor="@color/crl_ink_2"
          android:text="EV +0.0" />

      <Button
          android:id="@+id/btn_ev_up"
          style="@style/Crl.Button.Secondary.Small"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="EV +" />

      <Button
          android:id="@+id/btn_go_live"
          style="@style/Crl.Button.Primary.Large"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/crl_space_5"
          android:layout_marginEnd="@dimen/crl_space_5"
          android:minWidth="140dp"
          android:text="방송 시작" />

      <Button
          android:id="@+id/btn_mute"
          style="@style/Crl.Button.Secondary.Small"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="음소거" />
    </LinearLayout>
  </FrameLayout>
</FrameLayout>
