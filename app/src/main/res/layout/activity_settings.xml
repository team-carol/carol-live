<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crl_canvas"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/crl_space_6"
      android:paddingTop="@dimen/crl_space_7"
      android:paddingEnd="@dimen/crl_space_6"
      android:paddingBottom="@dimen/crl_space_9">

    <!-- page header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <TextView
          style="@style/Crl.Text.Heading2"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="방송 설정" />
      <Button
          android:id="@+id/btn_close"
          style="@style/Crl.Button.Secondary.Small"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="닫기" />
    </LinearLayout>

    <TextView
        style="@style/Crl.Text.BodySm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crl_space_2"
        android:layout_marginBottom="@dimen/crl_space_3"
        android:text="저장하면 방송 화면이 새 설정으로 다시 준비됨" />

    <!-- ===== 송출 ===== -->
    <LinearLayout style="@style/Crl.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView style="@style/Crl.Text.CardTitle" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:text="송출" />

      <TextView style="@style/Crl.Text.Label" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:layout_marginTop="@dimen/crl_space_5"
          android:text="서버 주소" />
      <EditText
          android:id="@+id/et_server"
          style="@style/Crl.Input"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3"
          android:hint="rtmp://a.rtmp.youtube.com/live2"
          android:importantForAutofill="no"
          android:inputType="textUri" />

      <TextView style="@style/Crl.Text.Label" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:layout_marginTop="@dimen/crl_space_5"
          android:text="스트림 키" />
      <EditText
          android:id="@+id/et_key"
          style="@style/Crl.Input"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3"
          android:hint="xxxx-xxxx-xxxx-xxxx-xxxx"
          android:importantForAutofill="no"
          android:inputType="textPassword" />
      <CheckBox
          android:id="@+id/cb_show_key"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_2"
          android:textColor="@color/crl_muted"
          android:textSize="@dimen/crl_type_caption"
          android:text="키 보기" />
      <TextView style="@style/Crl.Text.Helper" android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="키는 이 폰에만 저장되고 백업에도 안 올라감" />
    </LinearLayout>

    <!-- ===== 영상 ===== -->
    <LinearLayout style="@style/Crl.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView style="@style/Crl.Text.CardTitle" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:text="영상" />

      <TextView style="@style/Crl.Text.Label" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:layout_marginTop="@dimen/crl_space_5"
          android:text="해상도" />
      <RadioGroup android:id="@+id/rg_resolution" style="@style/Crl.Tabs"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3">
        <RadioButton android:id="@+id/res_1080" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1080p" />
        <RadioButton android:id="@+id/res_720" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="720p" />
      </RadioGroup>

      <TextView style="@style/Crl.Text.Label" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:layout_marginTop="@dimen/crl_space_5"
          android:text="프레임" />
      <RadioGroup android:id="@+id/rg_fps" style="@style/Crl.Tabs"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3">
        <RadioButton android:id="@+id/fps_60" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60fps" />
        <RadioButton android:id="@+id/fps_30" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30fps" />
      </RadioGroup>

      <TextView style="@style/Crl.Text.Label" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:layout_marginTop="@dimen/crl_space_5"
          android:text="영상 비트레이트 (kbps)" />
      <EditText
          android:id="@+id/et_video_bitrate"
          style="@style/Crl.Input"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3"
          android:importantForAutofill="no"
          android:inputType="number" />
      <TextView android:id="@+id/txt_bitrate_hint" style="@style/Crl.Text.Helper"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3" />

      <TextView style="@style/Crl.Text.Label" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:layout_marginTop="@dimen/crl_space_5"
          android:text="방향" />
      <RadioGroup android:id="@+id/rg_orientation" style="@style/Crl.Tabs"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3">
        <RadioButton android:id="@+id/orient_land" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="가로" />
        <RadioButton android:id="@+id/orient_port" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="세로" />
      </RadioGroup>

      <androidx.appcompat.widget.SwitchCompat
          android:id="@+id/sw_lock_fps"
          style="@style/Crl.Switch"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_4"
          android:text="프레임 고정" />
      <TextView style="@style/Crl.Text.Helper" android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="어두운 오락실에서도 프레임을 지킴. 대신 화면이 조금 어두워질 수 있어서 EV로 보정" />

      <TextView android:id="@+id/txt_camera_info" style="@style/Crl.Text.Caption"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_4" />
    </LinearLayout>

    <!-- ===== 오디오 ===== -->
    <LinearLayout style="@style/Crl.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView style="@style/Crl.Text.CardTitle" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:text="오디오" />

      <TextView style="@style/Crl.Text.Label" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:layout_marginTop="@dimen/crl_space_5"
          android:text="비트레이트" />
      <RadioGroup android:id="@+id/rg_audio_bitrate" style="@style/Crl.Tabs"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3">
        <RadioButton android:id="@+id/ab_128" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="128k" />
        <RadioButton android:id="@+id/ab_160" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="160k" />
        <RadioButton android:id="@+id/ab_192" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="192k" />
      </RadioGroup>

      <TextView style="@style/Crl.Text.Label" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:layout_marginTop="@dimen/crl_space_5"
          android:text="샘플레이트" />
      <RadioGroup android:id="@+id/rg_sample_rate" style="@style/Crl.Tabs"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3">
        <RadioButton android:id="@+id/sr_48" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="48kHz" />
        <RadioButton android:id="@+id/sr_44" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="44.1kHz" />
      </RadioGroup>

      <androidx.appcompat.widget.SwitchCompat
          android:id="@+id/sw_stereo"
          style="@style/Crl.Switch"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_4"
          android:text="스테레오" />
    </LinearLayout>

    <!-- ===== 마이크 ===== -->
    <LinearLayout style="@style/Crl.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView style="@style/Crl.Text.CardTitle" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:text="마이크" />

      <androidx.appcompat.widget.SwitchCompat
          android:id="@+id/sw_prefer_usb"
          style="@style/Crl.Switch"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_4"
          android:text="USB 마이크 우선 (DJI 수신기)" />

      <TextView style="@style/Crl.Text.Label" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:layout_marginTop="@dimen/crl_space_4"
          android:text="소리 처리" />
      <RadioGroup android:id="@+id/rg_mic_mode" style="@style/Crl.Tabs"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3">
        <RadioButton android:id="@+id/mic_unprocessed" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="원음" />
        <RadioButton android:id="@+id/mic_camcorder" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="캠코더" />
        <RadioButton android:id="@+id/mic_default" style="@style/Crl.Tab"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기본" />
      </RadioGroup>
      <TextView android:id="@+id/txt_mic_hint" style="@style/Crl.Text.Helper"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_3"
          android:text="원음: 폰이 자동 볼륨·잡음 제거를 안 걸음. 잡음 제거는 DJI 앱에서만 켜는 걸 추천" />

      <TextView style="@style/Crl.Text.Label" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:layout_marginTop="@dimen/crl_space_5"
          android:text="감지된 입력 장치" />
      <TextView android:id="@+id/txt_inputs" style="@style/Crl.Text.Caption"
          android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_2" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_save"
        style="@style/Crl.Button.Primary.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crl_space_7"
        android:text="저장" />
  </LinearLayout>
</ScrollView>
