<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_focused="true">
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
      <solid android:color="@color/crl_canvas_alt" />
      <stroke android:width="1dp" android:color="@color/crl_accent" />
      <corners android:radius="@dimen/crl_radius_control" />
    </shape>
  </item>
  <item>
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
      <solid android:color="@color/crl_canvas_alt" />
      <stroke android:width="1dp" android:color="@color/crl_border_strong" />
      <corners android:radius="@dimen/crl_radius_control" />
    </shape>
  </item>
</selector>
