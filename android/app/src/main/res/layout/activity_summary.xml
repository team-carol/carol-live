<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crl_canvas"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/crl_space_6"
      android:paddingTop="@dimen/crl_space_7"
      android:paddingEnd="@dimen/crl_space_6"
      android:paddingBottom="@dimen/crl_space_9">

    <TextView
        android:id="@+id/sum_tag"
        style="@style/Crl.Tag.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/sum_title"
        style="@style/Crl.Text.Heading2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crl_space_4" />

    <TextView
        android:id="@+id/sum_sub"
        style="@style/Crl.Text.BodySm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crl_space_2" />

    <!-- crl-stat-grid, filled in code -->
    <LinearLayout
        android:id="@+id/sum_stats"
        style="@style/Crl.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crl_space_7" />

    <LinearLayout
        style="@style/Crl.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

      <TextView style="@style/Crl.Text.CardTitle" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:text="녹화 파일" />

      <TextView
          android:id="@+id/sum_files"
          style="@style/Crl.Text.Caption"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_4"
          android:lineSpacingMultiplier="1.3" />

      <!-- songs the experimental readout found (SongSpotter), to compare with what was played -->
      <TextView
          android:id="@+id/sum_songs"
          style="@style/Crl.Text.Caption"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_4"
          android:lineSpacingMultiplier="1.3"
          android:visibility="gone" />

      <TextView
          android:id="@+id/sum_upload"
          style="@style/Crl.Text.Helper"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_4" />

      <Button
          android:id="@+id/sum_upload_now"
          style="@style/Crl.Button.Secondary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/crl_space_4"
          android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/sum_close"
        style="@style/Crl.Button.Primary.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crl_space_7"
        android:text="확인" />
  </LinearLayout>
</ScrollView>
