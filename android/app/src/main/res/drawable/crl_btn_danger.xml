<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
      <solid android:color="@color/crl_danger_border" />
      <stroke android:width="1dp" android:color="@color/crl_danger_border" />
      <corners android:radius="@dimen/crl_radius_button" />
    </shape>
  </item>
  <item>
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
      <solid android:color="@color/crl_danger_bg" />
      <stroke android:width="1dp" android:color="@color/crl_danger_border" />
      <corners android:radius="@dimen/crl_radius_button" />
    </shape>
  </item>
</selector>
